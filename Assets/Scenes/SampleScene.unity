  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.95, g: 0.93, b: 0.88, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 11
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.14
  m_Text: "\u2022 Estilo: Moyogi (Vertical Informal) \xB7 Edad: ~45 a\xF1os\n\u2022 Corteza: Casta\xF1o caoba satinado con lenticelas horizontales y ra\xEDces Nebari.\n\u2022 Simbolismo: Mono no aware (la serenidad ef\xEDmera de la primavera japonesa).\n\n\U0001F6E0 CUIDADO INDEPENDIENTE (AVISO NE\xD3N):\n\U0001F4A7 Riego: Usa el cazo de bamb\xFA (Hishaku) de la izquierda cuando brille el ne\xF3n azul.\n\u2702\uFE0F Poda: Corta con calma los brotes secos con las tijeras Hasami si brilla el ne\xF3n \xE1mbar.\n\U0001F9F9 Limpieza: Retira suavemente las orugas con la escobilla Hoki de la derecha."
